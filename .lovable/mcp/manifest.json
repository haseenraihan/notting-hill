{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "notting-hill-voyages",
      "version": "0.1.0",
      "title": "Notting Hill Voyages"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List the visa services and travel programs offered by Notting Hill Voyages, optionally filtered by category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "visa",
                "program"
              ],
              "description": "Filter by 'visa' services or travel/study 'program' offerings."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_service",
        "title": "Get service details",
        "description": "Get full details for one Notting Hill Voyages service or program by its slug (see list_services).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Service slug, e.g. 'uk-visit-visa'."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_contact_info",
        "title": "Get contact info",
        "description": "Get Notting Hill Voyages contact details and the consultation booking link.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "submit_inquiry",
        "title": "Submit travel inquiry",
        "description": "Send a travel, visa or study-abroad inquiry to the Notting Hill Voyages team. The team replies by email within 24 hours.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Full name of the person inquiring."
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Email address for the reply."
            },
            "phone": {
              "type": "string",
              "description": "Contact phone number, optional."
            },
            "destination": {
              "type": "string",
              "description": "Destination or service of interest, e.g. 'UK visit visa'."
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "Details of the inquiry."
            }
          },
          "required": [
            "name",
            "email",
            "message"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
